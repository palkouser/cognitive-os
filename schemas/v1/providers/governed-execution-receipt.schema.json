{
  "$defs": {
    "JsonPrimitive": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "JsonValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonPrimitive"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        }
      ]
    },
    "ModelFinishReason": {
      "enum": [
        "completed",
        "tool_call",
        "length",
        "content_filter",
        "cancelled",
        "error",
        "unknown"
      ],
      "title": "ModelFinishReason",
      "type": "string"
    },
    "ModelProviderResponse": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content"
        },
        "finish_reason": {
          "$ref": "#/$defs/ModelFinishReason"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "number"
        },
        "model_call_id": {
          "format": "uuid",
          "title": "Model Call Id",
          "type": "string"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "provider_request_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Request Id"
        },
        "requested_model": {
          "minLength": 1,
          "title": "Requested Model",
          "type": "string"
        },
        "resolved_model": {
          "minLength": 1,
          "title": "Resolved Model",
          "type": "string"
        },
        "structured_output": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "items": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Structured Output"
        },
        "tool_calls": {
          "default": [],
          "items": {
            "$ref": "#/$defs/NormalizedToolCall"
          },
          "title": "Tool Calls",
          "type": "array"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/TokenUsage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "model_call_id",
        "provider_id",
        "requested_model",
        "resolved_model",
        "finish_reason",
        "latency_ms"
      ],
      "title": "ModelProviderResponse",
      "type": "object"
    },
    "NormalizedToolCall": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Arguments",
          "type": "object"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "tool_call_id": {
          "minLength": 1,
          "title": "Tool Call Id",
          "type": "string"
        }
      },
      "required": [
        "tool_call_id",
        "name",
        "arguments"
      ],
      "title": "NormalizedToolCall",
      "type": "object"
    },
    "ProviderAdapterKind": {
      "description": "Which adapter produced the output.\n\nDistinct from `ProviderKind`: two adapters share `cli_agent`, and the governance ledger\nhas to be able to say *which* CLI answered.",
      "enum": [
        "minimax",
        "openrouter",
        "claude_code",
        "codex_cli",
        "replay",
        "mock"
      ],
      "title": "ProviderAdapterKind",
      "type": "string"
    },
    "ProviderOutputRetentionMode": {
      "description": "What is allowed to survive the call. `NONE` is the default everywhere.",
      "enum": [
        "none",
        "hash_only",
        "normalized_content"
      ],
      "title": "ProviderOutputRetentionMode",
      "type": "string"
    },
    "TokenUsage": {
      "additionalProperties": false,
      "properties": {
        "cached_input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cached Input Tokens"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "reasoning_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Tokens"
        },
        "total_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Tokens"
        }
      },
      "title": "TokenUsage",
      "type": "object"
    }
  },
  "$id": "https://cognitive-os.local/schemas/v1/providers/governed-execution-receipt.schema.json",
  "additionalProperties": false,
  "description": "What one governed provider execution produced, by identity and hash.\n\nDeliberately not a superset of the response: it carries the normalized response the\ncaller already has a right to see, plus the *handles* that make the call auditable. No\nraw provider payload, no request body, no credential, no routing detail beyond what the\nallowlist permitted into the response itself.",
  "properties": {
    "adapter_kind": {
      "$ref": "#/$defs/ProviderAdapterKind"
    },
    "completed_event_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed Event Id"
    },
    "model_call_id": {
      "format": "uuid",
      "title": "Model Call Id",
      "type": "string"
    },
    "normalized_response_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Normalized Response Hash",
      "type": "string"
    },
    "provider_id": {
      "minLength": 1,
      "title": "Provider Id",
      "type": "string"
    },
    "provider_output_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Output Id"
    },
    "provider_output_revision": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Output Revision"
    },
    "request_artifact_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request Artifact Id"
    },
    "request_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Hash",
      "type": "string"
    },
    "requested_model": {
      "minLength": 1,
      "title": "Requested Model",
      "type": "string"
    },
    "resolved_model": {
      "minLength": 1,
      "title": "Resolved Model",
      "type": "string"
    },
    "response": {
      "$ref": "#/$defs/ModelProviderResponse"
    },
    "response_artifact_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Response Artifact Id"
    },
    "retention_mode": {
      "$ref": "#/$defs/ProviderOutputRetentionMode"
    }
  },
  "required": [
    "response",
    "provider_id",
    "adapter_kind",
    "requested_model",
    "resolved_model",
    "request_hash",
    "normalized_response_hash",
    "model_call_id",
    "retention_mode"
  ],
  "title": "GovernedExecutionReceipt",
  "type": "object"
}
