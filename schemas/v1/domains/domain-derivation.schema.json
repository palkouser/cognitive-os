{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "storage_key": {
          "minLength": 1,
          "title": "Storage Key",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "content_hash",
        "size_bytes",
        "storage_key",
        "created_at"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "DerivationStep": {
      "additionalProperties": false,
      "description": "One typed step; provider prose alone can never constitute a derivation.",
      "properties": {
        "content_hash": {
          "default": "",
          "title": "Content Hash",
          "type": "string"
        },
        "detail": {
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "inputs": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Inputs",
          "type": "array"
        },
        "operation": {
          "minLength": 1,
          "title": "Operation",
          "type": "string"
        },
        "output": {
          "minLength": 1,
          "title": "Output",
          "type": "string"
        },
        "tool_evidence": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Evidence"
        }
      },
      "required": [
        "index",
        "operation",
        "detail",
        "output"
      ],
      "title": "DerivationStep",
      "type": "object"
    }
  },
  "$id": "https://cognitive-os.local/schemas/v1/domains/domain-derivation.schema.json",
  "additionalProperties": false,
  "properties": {
    "assumptions": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "content_hash": {
      "default": "",
      "title": "Content Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "derivation_id": {
      "format": "uuid",
      "title": "Derivation Id",
      "type": "string"
    },
    "equations": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Equations",
      "type": "array"
    },
    "expressions": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Expressions",
      "type": "array"
    },
    "intermediate_results": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Intermediate Results",
      "type": "array"
    },
    "limitations": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "logical_constraints": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Logical Constraints",
      "type": "array"
    },
    "problem_id": {
      "format": "uuid",
      "title": "Problem Id",
      "type": "string"
    },
    "provider_evidence": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Provider Evidence",
      "type": "array"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/DerivationStep"
      },
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    },
    "tool_evidence": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Tool Evidence",
      "type": "array"
    },
    "trace_artifact": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "unit_states": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Unit States",
      "type": "array"
    }
  },
  "required": [
    "derivation_id",
    "problem_id",
    "steps",
    "created_at"
  ],
  "title": "DomainDerivation",
  "type": "object"
}
