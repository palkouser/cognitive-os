{
  "$defs": {
    "JsonPrimitive": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "JsonValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonPrimitive"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        }
      ]
    },
    "VerificationDisposition": {
      "enum": [
        "pass",
        "partial",
        "fail",
        "inconclusive",
        "unsupported",
        "resource_exhausted"
      ],
      "title": "VerificationDisposition",
      "type": "string"
    }
  },
  "$id": "https://cognitive-os.local/schemas/v1/domains/verification-check-result.schema.json",
  "additionalProperties": false,
  "properties": {
    "capability": {
      "minLength": 1,
      "title": "Capability",
      "type": "string"
    },
    "content_hash": {
      "default": "",
      "title": "Content Hash",
      "type": "string"
    },
    "detail": {
      "minLength": 1,
      "title": "Detail",
      "type": "string"
    },
    "disposition": {
      "$ref": "#/$defs/VerificationDisposition"
    },
    "evidence": {
      "$ref": "#/$defs/JsonValue",
      "default": null
    }
  },
  "required": [
    "capability",
    "disposition",
    "detail"
  ],
  "title": "VerificationCheckResult",
  "type": "object"
}
