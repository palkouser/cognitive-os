{
  "$defs": {
    "AnswerType": {
      "enum": [
        "exact",
        "approximate",
        "symbolic",
        "quantity",
        "boolean",
        "satisfiable",
        "unsatisfiable",
        "unknown",
        "counterexample",
        "structured"
      ],
      "title": "AnswerType",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "storage_key": {
          "minLength": 1,
          "title": "Storage Key",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "content_hash",
        "size_bytes",
        "storage_key",
        "created_at"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "DomainAnswer": {
      "additionalProperties": false,
      "properties": {
        "answer_type": {
          "$ref": "#/$defs/AnswerType"
        },
        "approximate_value": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approximate Value"
        },
        "content_hash": {
          "default": "",
          "title": "Content Hash",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "exact_value": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exact Value"
        },
        "limitations": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "logical_status": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Logical Status"
        },
        "problem_id": {
          "format": "uuid",
          "title": "Problem Id",
          "type": "string"
        },
        "proof_or_derivation_reference": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proof Or Derivation Reference"
        },
        "structured_value": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Structured Value",
          "type": "object"
        },
        "symbolic_form": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Symbolic Form"
        },
        "tolerance": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tolerance"
        },
        "uncertainty": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uncertainty"
        },
        "units": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Units"
        }
      },
      "required": [
        "problem_id",
        "answer_type",
        "created_at"
      ],
      "title": "DomainAnswer",
      "type": "object"
    },
    "DomainKind": {
      "enum": [
        "mathematics",
        "physics",
        "logic"
      ],
      "title": "DomainKind",
      "type": "string"
    },
    "DomainProblem": {
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "constraints": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Constraints",
          "type": "array"
        },
        "content_hash": {
          "default": "",
          "title": "Content Hash",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "domain": {
          "$ref": "#/$defs/DomainKind"
        },
        "expected_output_schema": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Expected Output Schema",
          "type": "object"
        },
        "formal_inputs": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Formal Inputs",
          "type": "object"
        },
        "knowns": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Knowns",
          "type": "object"
        },
        "problem_id": {
          "format": "uuid",
          "title": "Problem Id",
          "type": "string"
        },
        "problem_type": {
          "minLength": 1,
          "title": "Problem Type",
          "type": "string"
        },
        "required_tools": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Required Tools",
          "type": "array"
        },
        "required_units": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Required Units",
          "type": "array"
        },
        "required_verifiers": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Required Verifiers",
          "type": "array"
        },
        "risk": {
          "default": "low",
          "minLength": 1,
          "title": "Risk",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProvenanceRef"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "statement_artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "unknowns": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Unknowns",
          "type": "array"
        }
      },
      "required": [
        "problem_id",
        "domain",
        "problem_type",
        "statement",
        "required_verifiers",
        "created_at"
      ],
      "title": "DomainProblem",
      "type": "object"
    },
    "DomainVerificationPlan": {
      "additionalProperties": false,
      "description": "Frozen before execution: nothing runs without a plan.",
      "properties": {
        "acceptance_policy": {
          "default": "all_required_checks_must_pass",
          "minLength": 1,
          "title": "Acceptance Policy",
          "type": "string"
        },
        "alternative_solution_checks": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Alternative Solution Checks",
          "type": "array"
        },
        "constraint_checks": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Constraint Checks",
          "type": "array"
        },
        "content_hash": {
          "default": "",
          "title": "Content Hash",
          "type": "string"
        },
        "edge_cases": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Edge Cases",
          "type": "array"
        },
        "forbidden_operations": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Forbidden Operations",
          "type": "array"
        },
        "numeric_checks": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Numeric Checks",
          "type": "array"
        },
        "problem_id": {
          "format": "uuid",
          "title": "Problem Id",
          "type": "string"
        },
        "property_checks": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Property Checks",
          "type": "array"
        },
        "required_capabilities": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Required Capabilities",
          "type": "array"
        },
        "resource_budget": {
          "$ref": "#/$defs/ResourceBudget"
        },
        "symbolic_checks": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Symbolic Checks",
          "type": "array"
        },
        "unit_checks": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Unit Checks",
          "type": "array"
        }
      },
      "required": [
        "problem_id",
        "required_capabilities"
      ],
      "title": "DomainVerificationPlan",
      "type": "object"
    },
    "JsonPrimitive": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "JsonValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonPrimitive"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        }
      ]
    },
    "ProvenanceRef": {
      "additionalProperties": false,
      "description": "Source, licence, and contamination metadata required before activation.",
      "properties": {
        "checksum": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checksum"
        },
        "contamination_notes": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contamination Notes"
        },
        "content_hash": {
          "default": "",
          "title": "Content Hash",
          "type": "string"
        },
        "effective_date": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Date"
        },
        "licence": {
          "minLength": 1,
          "title": "Licence",
          "type": "string"
        },
        "redistributable": {
          "title": "Redistributable",
          "type": "boolean"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "revision",
        "licence",
        "redistributable"
      ],
      "title": "ProvenanceRef",
      "type": "object"
    },
    "ResourceBudget": {
      "additionalProperties": false,
      "description": "Ceilings validated before execution and enforced during it.",
      "properties": {
        "content_hash": {
          "default": "",
          "title": "Content Hash",
          "type": "string"
        },
        "maximum_depth": {
          "default": 32,
          "exclusiveMinimum": 0,
          "maximum": 256,
          "title": "Maximum Depth",
          "type": "integer"
        },
        "maximum_integer_digits": {
          "default": 256,
          "exclusiveMinimum": 0,
          "maximum": 4096,
          "title": "Maximum Integer Digits",
          "type": "integer"
        },
        "maximum_nodes": {
          "default": 512,
          "exclusiveMinimum": 0,
          "maximum": 8192,
          "title": "Maximum Nodes",
          "type": "integer"
        },
        "maximum_output_bytes": {
          "default": 65536,
          "exclusiveMinimum": 0,
          "maximum": 4194304,
          "title": "Maximum Output Bytes",
          "type": "integer"
        },
        "maximum_retries": {
          "default": 0,
          "maximum": 3,
          "minimum": 0,
          "title": "Maximum Retries",
          "type": "integer"
        },
        "maximum_symbols": {
          "default": 32,
          "exclusiveMinimum": 0,
          "maximum": 1024,
          "title": "Maximum Symbols",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 10,
          "exclusiveMinimum": 0,
          "maximum": 300,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "title": "ResourceBudget",
      "type": "object"
    },
    "VerificationDisposition": {
      "enum": [
        "pass",
        "partial",
        "fail",
        "inconclusive",
        "unsupported",
        "resource_exhausted"
      ],
      "title": "VerificationDisposition",
      "type": "string"
    }
  },
  "$id": "https://cognitive-os.local/schemas/v1/domains/domain-benchmark-case.schema.json",
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "contamination_notes": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Contamination Notes"
    },
    "content_hash": {
      "default": "",
      "title": "Content Hash",
      "type": "string"
    },
    "difficulty": {
      "minLength": 1,
      "title": "Difficulty",
      "type": "string"
    },
    "domain": {
      "$ref": "#/$defs/DomainKind"
    },
    "expected_answer": {
      "$ref": "#/$defs/DomainAnswer"
    },
    "expected_disposition": {
      "$ref": "#/$defs/VerificationDisposition"
    },
    "expected_properties": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Expected Properties",
      "type": "object"
    },
    "forbidden_operations": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Forbidden Operations",
      "type": "array"
    },
    "licence_and_source": {
      "$ref": "#/$defs/ProvenanceRef"
    },
    "plan": {
      "$ref": "#/$defs/DomainVerificationPlan"
    },
    "problem": {
      "$ref": "#/$defs/DomainProblem"
    },
    "problem_artifact": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "problem_type": {
      "minLength": 1,
      "title": "Problem Type",
      "type": "string"
    },
    "required_tools": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Required Tools",
      "type": "array"
    },
    "required_verifiers": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Required Verifiers",
      "type": "array"
    },
    "resource_budget": {
      "$ref": "#/$defs/ResourceBudget"
    }
  },
  "required": [
    "case_id",
    "domain",
    "problem_type",
    "difficulty",
    "problem",
    "plan",
    "expected_answer",
    "expected_disposition",
    "required_verifiers",
    "licence_and_source"
  ],
  "title": "DomainBenchmarkCase",
  "type": "object"
}
