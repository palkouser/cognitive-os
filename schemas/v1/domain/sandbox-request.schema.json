{
  "$defs": {
    "SandboxLimits": {
      "additionalProperties": false,
      "properties": {
        "cpu_count": {
          "exclusiveMinimum": 0,
          "maximum": 32,
          "title": "Cpu Count",
          "type": "number"
        },
        "maximum_artifact_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 1073741824,
          "title": "Maximum Artifact Bytes",
          "type": "integer"
        },
        "maximum_stderr_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 16777216,
          "title": "Maximum Stderr Bytes",
          "type": "integer"
        },
        "maximum_stdout_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 16777216,
          "title": "Maximum Stdout Bytes",
          "type": "integer"
        },
        "memory_bytes": {
          "maximum": 68719476736,
          "minimum": 134217728,
          "title": "Memory Bytes",
          "type": "integer"
        },
        "network_enabled": {
          "default": false,
          "title": "Network Enabled",
          "type": "boolean"
        },
        "pid_limit": {
          "maximum": 4096,
          "minimum": 16,
          "title": "Pid Limit",
          "type": "integer"
        },
        "timeout_seconds": {
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Timeout Seconds",
          "type": "number"
        }
      },
      "required": [
        "timeout_seconds",
        "memory_bytes",
        "cpu_count",
        "pid_limit",
        "maximum_stdout_bytes",
        "maximum_stderr_bytes",
        "maximum_artifact_bytes"
      ],
      "title": "SandboxLimits",
      "type": "object"
    },
    "SandboxVerificationInput": {
      "additionalProperties": false,
      "description": "The one read-only control mount a hidden verifier may receive, Sprint 21C3.\n\nDeliberately not a general mount list. A verifier needs exactly one trusted input at\nexactly one destination, and `container_path` is a `Literal` so that widening it is a\ncontract change someone has to make on purpose rather than a config value someone can\nset. There is no writable variant: the hidden tests are the answer key, and a container\nthat could write to them could rewrite the answer.\n\n`content_hash` is a `snapshot_workspace` tree digest, checked immediately before the\ncontainer starts. A changed bundle fails closed rather than running against unknown\ntests.",
      "properties": {
        "container_path": {
          "const": "/verification",
          "default": "/verification",
          "title": "Container Path",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "host_path": {
          "title": "Host Path",
          "type": "string"
        }
      },
      "required": [
        "host_path",
        "content_hash"
      ],
      "title": "SandboxVerificationInput",
      "type": "object"
    }
  },
  "$id": "https://cognitive-os.local/schemas/v1/domain/sandbox-request.schema.json",
  "additionalProperties": false,
  "properties": {
    "arguments": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Arguments",
      "type": "array"
    },
    "executable": {
      "title": "Executable",
      "type": "string"
    },
    "limits": {
      "$ref": "#/$defs/SandboxLimits"
    },
    "sandbox_id": {
      "title": "Sandbox Id",
      "type": "string"
    },
    "task_run_id": {
      "title": "Task Run Id",
      "type": "string"
    },
    "tool_call_id": {
      "title": "Tool Call Id",
      "type": "string"
    },
    "verification_input": {
      "anyOf": [
        {
          "$ref": "#/$defs/SandboxVerificationInput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "workspace": {
      "title": "Workspace",
      "type": "string"
    }
  },
  "required": [
    "sandbox_id",
    "tool_call_id",
    "task_run_id",
    "workspace",
    "executable",
    "limits"
  ],
  "title": "SandboxRequest",
  "type": "object"
}
