{
  "$defs": {
    "RealityCandidateSource": {
      "description": "Who produced the patch. Not who decided whether it works — that is the verifier.",
      "enum": [
        "baseline",
        "curated",
        "codex_cli",
        "claude_code",
        "openrouter"
      ],
      "title": "RealityCandidateSource",
      "type": "string"
    },
    "RealityCandidateStrategy": {
      "description": "The four offline strategies of §4.6, plus what a provider returns.\n\n`PROVIDER_PROPOSED` deliberately has no declared correctness. A provider candidate's\nresult is whatever the hidden verifier says it is, and a strategy value that predicted\nit would be a label the corpus had assigned to itself.",
      "enum": [
        "incomplete_a",
        "correct_narrow",
        "incomplete_b",
        "correct_robust",
        "provider_proposed"
      ],
      "title": "RealityCandidateStrategy",
      "type": "string"
    },
    "RealityRunIdentity": {
      "additionalProperties": false,
      "description": "What makes a planned campaign run the same run on resume, §4.14.\n\nEvery field that changes the executed work is in here. Resume skips an identity that has\nalready produced a counted outcome; the same identity presenting different content is a\nnew campaign revision, not an update.",
      "properties": {
        "campaign_version": {
          "minimum": 1,
          "title": "Campaign Version",
          "type": "integer"
        },
        "candidate_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Id"
        },
        "content_hash": {
          "default": "",
          "title": "Content Hash",
          "type": "string"
        },
        "generator_profile_id": {
          "minLength": 1,
          "title": "Generator Profile Id",
          "type": "string"
        },
        "run_kind": {
          "$ref": "#/$defs/RealityRunKind"
        },
        "source": {
          "$ref": "#/$defs/RealityCandidateSource"
        },
        "strategy": {
          "anyOf": [
            {
              "$ref": "#/$defs/RealityCandidateStrategy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "task_id": {
          "format": "uuid",
          "title": "Task Id",
          "type": "string"
        },
        "task_manifest_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Task Manifest Hash",
          "type": "string"
        },
        "verifier_profile_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Verifier Profile Hash",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "task_manifest_hash",
        "run_kind",
        "source",
        "generator_profile_id",
        "verifier_profile_hash",
        "campaign_version"
      ],
      "title": "RealityRunIdentity",
      "type": "object"
    },
    "RealityRunKind": {
      "enum": [
        "baseline",
        "candidate"
      ],
      "title": "RealityRunKind",
      "type": "string"
    }
  },
  "$id": "https://cognitive-os.local/schemas/v1/reality/reality-campaign-manifest.schema.json",
  "additionalProperties": false,
  "description": "The frozen plan for one campaign revision.\n\nProvider assignment is frozen here, before execution, so that \"which tasks went to\nOpenRouter\" cannot be decided after seeing which ones it got right.",
  "properties": {
    "campaign_id": {
      "format": "uuid",
      "title": "Campaign Id",
      "type": "string"
    },
    "campaign_version": {
      "minimum": 1,
      "title": "Campaign Version",
      "type": "integer"
    },
    "content_hash": {
      "default": "",
      "title": "Content Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "live_providers_enabled": {
      "default": false,
      "title": "Live Providers Enabled",
      "type": "boolean"
    },
    "planned_runs": {
      "items": {
        "$ref": "#/$defs/RealityRunIdentity"
      },
      "maxItems": 4096,
      "minItems": 1,
      "title": "Planned Runs",
      "type": "array"
    },
    "verifier_profile_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Verifier Profile Hash",
      "type": "string"
    }
  },
  "required": [
    "campaign_id",
    "campaign_version",
    "planned_runs",
    "verifier_profile_hash",
    "created_at"
  ],
  "title": "RealityCampaignManifest",
  "type": "object"
}
