{
  "$defs": {
    "CorpusDestinationType": {
      "enum": [
        "governed_memory_candidate",
        "semantic_observation_candidate",
        "skill_candidate",
        "strategy_candidate",
        "routing_observation",
        "weakness_signal",
        "benchmark_case",
        "replay_fixture",
        "negative_example",
        "training_corpus",
        "reference_corpus",
        "quarantine",
        "reject"
      ],
      "title": "CorpusDestinationType",
      "type": "string"
    },
    "CorpusLicenseStatus": {
      "enum": [
        "approved",
        "internal",
        "unknown",
        "conflicting",
        "restricted"
      ],
      "title": "CorpusLicenseStatus",
      "type": "string"
    },
    "CorpusSourceType": {
      "enum": [
        "experience_candidate",
        "verified_trajectory",
        "memory_export",
        "semantic_export",
        "skill_package",
        "strategy_package",
        "repository_snapshot",
        "document",
        "benchmark_dataset",
        "operator_annotation",
        "provider_generated_dataset",
        "external_local_archive",
        "cognitive_os_export"
      ],
      "title": "CorpusSourceType",
      "type": "string"
    },
    "CorpusUsageRight": {
      "enum": [
        "internal_use",
        "redistribution",
        "modification",
        "derivative_work",
        "benchmark_use",
        "model_training",
        "commercial_use",
        "public_release"
      ],
      "title": "CorpusUsageRight",
      "type": "string"
    },
    "MemorySensitivity": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ],
      "title": "MemorySensitivity",
      "type": "string"
    },
    "OperatorLicenseClearance": {
      "additionalProperties": false,
      "description": "A person's decision about what material may be used for, and who answers for it.\n\n**Sprint 22C W1-D2.** The Corpus Factory used to decide licence status from an allowlist\nof identifiers, and record the result in a `LicenseDeclaration` whose `declared_by` named\nan operator. The field said a human had declared it; the allowlist had. That is a design\nerror and not merely a gap: **classifying material and authorising its use is a legal\ndetermination, and the legal responsibility is the operator's, so the decision has to be\ntheirs.**\n\nWhat the program may do is read a licence if there is one, recognise it if it can, and\n**advise**. What it may not do is grant use. This contract is where the authority lives:\nan identifier, the operator's determination, what they permit it to be used for, who\nthey are by name, when they decided, and the bytes they decided about.\n\nTwo invariants, both refusals:\n\n*A clearance is a decision.* `unknown` and `conflicting` are the absence of one, and a\nrecord carrying them would be an operator declining to decide while looking like an\noperator who had.\n\n*A clearance covers bytes, not titles.* `source_content_hash` is what the decision was\nmade about, so a clearance cannot drift onto a different edition of the same work.\n\nAbsent a clearance the factory still fails closed — the asymmetry is the point. The\nprogram may refuse on its own; it may never permit on its own.",
      "properties": {
        "cleared_at": {
          "format": "date-time",
          "title": "Cleared At",
          "type": "string"
        },
        "cleared_by": {
          "minLength": 1,
          "title": "Cleared By",
          "type": "string"
        },
        "content_hash": {
          "default": "",
          "title": "Content Hash",
          "type": "string"
        },
        "evidence_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Hash",
          "type": "string"
        },
        "identifier": {
          "minLength": 1,
          "title": "Identifier",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "permitted_uses": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CorpusUsageRight"
          },
          "title": "Permitted Uses",
          "type": "array"
        },
        "source_content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Content Hash",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CorpusLicenseStatus"
        }
      },
      "required": [
        "identifier",
        "status",
        "cleared_by",
        "cleared_at",
        "evidence_hash",
        "source_content_hash"
      ],
      "title": "OperatorLicenseClearance",
      "type": "object"
    }
  },
  "$id": "https://cognitive-os.local/schemas/v1/corpus/corpus-factory-request.schema.json",
  "additionalProperties": false,
  "description": "One governed ingest.\n\n`split_group_key` names the group every item in this request belongs to — a repository\ngroup, a generator template, a task family. When it is set the split is a function of\nthat key rather than of each item's lineage, which is what keeps two variants of one task\nfrom landing on opposite sides of an evaluation boundary. Left unset, splits stay\nper-lineage, which is what every source before Sprint 21C3 wants.",
  "properties": {
    "content_hash": {
      "default": "",
      "title": "Content Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "minLength": 1,
      "title": "Created By",
      "type": "string"
    },
    "license_clearances": {
      "default": [],
      "items": {
        "$ref": "#/$defs/OperatorLicenseClearance"
      },
      "title": "License Clearances",
      "type": "array"
    },
    "license_identifiers": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "License Identifiers",
      "type": "array"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "requested_destination": {
      "anyOf": [
        {
          "$ref": "#/$defs/CorpusDestinationType"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "scope": {
      "minLength": 1,
      "title": "Scope",
      "type": "string"
    },
    "sensitivity": {
      "$ref": "#/$defs/MemorySensitivity"
    },
    "source_identity": {
      "minLength": 1,
      "title": "Source Identity",
      "type": "string"
    },
    "source_revision": {
      "minLength": 1,
      "title": "Source Revision",
      "type": "string"
    },
    "source_type": {
      "$ref": "#/$defs/CorpusSourceType"
    },
    "split_group_key": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Split Group Key"
    },
    "usage_rights": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "propertyNames": {
        "$ref": "#/$defs/CorpusUsageRight"
      },
      "title": "Usage Rights",
      "type": "object"
    }
  },
  "required": [
    "request_id",
    "source_type",
    "source_identity",
    "source_revision",
    "scope",
    "sensitivity",
    "usage_rights",
    "created_at",
    "created_by"
  ],
  "title": "CorpusFactoryRequest",
  "type": "object"
}
