{
  "$id": "https://cognitive-os.local/schemas/v1/experience-graph/graph-resource-limits.schema.json",
  "additionalProperties": false,
  "description": "The pre-registered bounds. A change must be committed before the next benchmark.",
  "properties": {
    "content_hash": {
      "default": "",
      "title": "Content Hash",
      "type": "string"
    },
    "cross_task_similarity_neighbors": {
      "default": 3,
      "maximum": 50,
      "minimum": 0,
      "title": "Cross Task Similarity Neighbors",
      "type": "integer"
    },
    "edges_per_graph": {
      "default": 128,
      "maximum": 8192,
      "minimum": 1,
      "title": "Edges Per Graph",
      "type": "integer"
    },
    "nodes_per_graph": {
      "default": 64,
      "maximum": 4096,
      "minimum": 1,
      "title": "Nodes Per Graph",
      "type": "integer"
    },
    "path_depth": {
      "default": 32,
      "maximum": 512,
      "minimum": 1,
      "title": "Path Depth",
      "type": "integer"
    },
    "per_pair_ged_timeout_ms": {
      "default": 250,
      "maximum": 60000,
      "minimum": 1,
      "title": "Per Pair Ged Timeout Ms",
      "type": "integer"
    },
    "query_budget_seconds": {
      "default": 2,
      "maximum": 600,
      "minimum": 1,
      "title": "Query Budget Seconds",
      "type": "integer"
    },
    "returned_results": {
      "default": 10,
      "maximum": 100,
      "minimum": 1,
      "title": "Returned Results",
      "type": "integer"
    },
    "vector_shortlist": {
      "default": 10,
      "maximum": 100,
      "minimum": 1,
      "title": "Vector Shortlist",
      "type": "integer"
    }
