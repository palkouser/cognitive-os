{
  "$defs": {
    "D3ArtifactBinding": {
      "additionalProperties": false,
      "description": "The stored model bytes, described exactly as the Artifact Store describes them.\n\nMedia type, schema and size travel with the hash because activation revalidates all four.\nAn artifact substituted for one with the same hash is impossible; one substituted for a\ndifferent artifact whose *metadata row* was edited is not, unless the metadata is bound too.",
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_name": {
          "minLength": 1,
          "title": "Schema Name",
          "type": "string"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "size_bytes": {
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "schema_name",
        "schema_version",
        "content_hash",
        "size_bytes"
      ],
      "title": "D3ArtifactBinding",
      "type": "object"
    },
    "PromotionDependency": {
      "additionalProperties": false,
      "description": "One thing this promotion is downstream of, and the exact revision of it that was used.",
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "content_hash"
      ],
      "title": "PromotionDependency",
      "type": "object"
    },
    "PromotionGateOutcome": {
      "description": "What one gate concluded.\n\n`NOT_MEASURED` is not a weak `FAILED`. A gate that failed has a measurement and a verdict;\na gate nobody ran has neither, and the second is the one that quietly turns a promotion\ninto an assertion. Both refuse eligibility; only one of them names a result.",
      "enum": [
        "passed",
        "failed",
        "not_measured"
      ],
      "title": "PromotionGateOutcome",
      "type": "string"
    },
    "PromotionGateRecord": {
      "additionalProperties": false,
      "description": "One gate's measured result, and the evidence hash it is derived from.",
      "properties": {
        "detail": {
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "evidence_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Hash",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/PromotionGateOutcome"
        }
      },
      "required": [
        "name",
        "outcome",
        "evidence_hash",
        "detail"
      ],
      "title": "PromotionGateRecord",
      "type": "object"
    }
  },
  "$id": "https://cognitive-os.local/schemas/v1/learned/d3-promotion-payload.schema.json",
  "additionalProperties": false,
  "description": "Every gate, every dependency, both configurations, and the bytes they are all about.",
  "properties": {
    "artifact": {
      "$ref": "#/$defs/D3ArtifactBinding"
    },
    "canary_configuration_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Canary Configuration Hash",
      "type": "string"
    },
    "canary_to_steady_condition_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Canary To Steady Condition Hash",
      "type": "string"
    },
    "code_revision": {
      "minLength": 1,
      "title": "Code Revision",
      "type": "string"
    },
    "component_id": {
      "minLength": 1,
      "title": "Component Id",
      "type": "string"
    },
    "component_revision": {
      "minimum": 1,
      "title": "Component Revision",
      "type": "integer"
    },
    "content_hash": {
      "default": "",
      "title": "Content Hash",
      "type": "string"
    },
    "dependencies": {
      "items": {
        "$ref": "#/$defs/PromotionDependency"
      },
      "minItems": 1,
      "title": "Dependencies",
      "type": "array"
    },
    "gates": {
      "items": {
        "$ref": "#/$defs/PromotionGateRecord"
      },
      "minItems": 1,
      "title": "Gates",
      "type": "array"
    },
    "legacy_assessment_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Legacy Assessment Hash",
      "type": "string"
    },
    "legacy_decision": {
      "minLength": 1,
      "title": "Legacy Decision",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "schema_name": {
      "default": "d3-promotion-payload",
      "minLength": 1,
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "default": 2,
      "minimum": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "steady_state_configuration_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Steady State Configuration Hash",
      "type": "string"
    },
    "surface": {
      "minLength": 1,
      "title": "Surface",
      "type": "string"
    }
  },
  "required": [
    "component_id",
    "component_revision",
    "surface",
    "code_revision",
    "legacy_assessment_hash",
    "legacy_decision",
    "gates",
    "dependencies",
    "artifact",
    "canary_configuration_hash",
    "steady_state_configuration_hash",
    "canary_to_steady_condition_hash",
    "recorded_at"
  ],
  "title": "D3PromotionPayload",
  "type": "object"
}
