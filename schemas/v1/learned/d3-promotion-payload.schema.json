{
  "$defs": {
    "D3ArtifactBinding": {
      "additionalProperties": false,
      "description": "The stored model bytes, described exactly as the Artifact Store describes them.\n\nMedia type, schema and size travel with the hash because activation revalidates all four.\nAn artifact substituted for one with the same hash is impossible; one substituted for a\ndifferent artifact whose *metadata row* was edited is not, unless the metadata is bound too.",
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_name": {
          "minLength": 1,
          "title": "Schema Name",
          "type": "string"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "size_bytes": {
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "schema_name",
        "schema_version",
        "content_hash",
        "size_bytes"
      ],
      "title": "D3ArtifactBinding",
      "type": "object"
    },
    "PromotionDecisionCounts": {
      "additionalProperties": false,
      "description": "S21D4-048: condition 20's two denominators, and the certificate its threshold came from.\n\nD3 recorded 120 metamorphic ranking decisions and condition 20 read them as 120. They were\n20 decisions replicated six times, because six semantics-preserving transformations of one\ngroup encode to one fitted vector. Nothing in the D3 payload could have caught that: the row\nnamed one number, so there was no second number for it to disagree with.\n\nBoth are named here, and the rates are over the independent one. The certificate hash binds\nthe operating point the confident-error count was measured at, so \"zero confident errors\"\ncannot be read apart from the threshold that decided which decisions were answered.\n\nThe census rule itself lives in `learning.correction_protocol.DecisionCensusV4` and is not\nrestated here — `learning.promotion.condition_20_gate` is how these fields get filled, and it\ntakes a census rather than three integers.",
      "properties": {
        "calibration_certificate_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Calibration Certificate Hash",
          "type": "string"
        },
        "hypothesis_class": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hypothesis Class"
        },
        "independent_decisions": {
          "minimum": 0,
          "title": "Independent Decisions",
          "type": "integer"
        },
        "nominal_decisions": {
          "minimum": 0,
          "title": "Nominal Decisions",
          "type": "integer"
        }
      },
      "required": [
        "nominal_decisions",
        "independent_decisions",
        "calibration_certificate_hash"
      ],
      "title": "PromotionDecisionCounts",
      "type": "object"
    },
    "PromotionDependency": {
      "additionalProperties": false,
      "description": "One thing this promotion is downstream of, and the exact revision of it that was used.",
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "content_hash"
      ],
      "title": "PromotionDependency",
      "type": "object"
    },
    "PromotionGateOutcome": {
      "description": "What one gate concluded.\n\n`NOT_MEASURED` is not a weak `FAILED`. A gate that failed has a measurement and a verdict;\na gate nobody ran has neither, and the second is the one that quietly turns a promotion\ninto an assertion. Both refuse eligibility; only one of them names a result.",
      "enum": [
        "passed",
        "failed",
        "not_measured"
      ],
      "title": "PromotionGateOutcome",
      "type": "string"
    },
    "PromotionGateRecord": {
      "additionalProperties": false,
      "description": "One gate's measured result, and the evidence hash it is derived from.",
      "properties": {
        "decision_counts": {
          "anyOf": [
            {
              "$ref": "#/$defs/PromotionDecisionCounts"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "detail": {
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "evidence_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Hash",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/PromotionGateOutcome"
        }
      },
      "required": [
        "name",
        "outcome",
        "evidence_hash",
        "detail"
      ],
      "title": "PromotionGateRecord",
      "type": "object"
    }
  },
  "$id": "https://cognitive-os.local/schemas/v1/learned/d3-promotion-payload.schema.json",
  "additionalProperties": false,
  "description": "Every gate, every dependency, both configurations, and the bytes they are all about.",
  "properties": {
    "artifact": {
      "$ref": "#/$defs/D3ArtifactBinding"
    },
    "canary_configuration_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Canary Configuration Hash",
      "type": "string"
    },
    "canary_to_steady_condition_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Canary To Steady Condition Hash",
      "type": "string"
    },
    "code_revision": {
      "minLength": 1,
      "title": "Code Revision",
      "type": "string"
    },
    "component_id": {
      "minLength": 1,
      "title": "Component Id",
      "type": "string"
    },
    "component_revision": {
      "minimum": 1,
      "title": "Component Revision",
      "type": "integer"
    },
    "content_hash": {
      "default": "",
      "title": "Content Hash",
      "type": "string"
    },
    "dependencies": {
      "items": {
        "$ref": "#/$defs/PromotionDependency"
      },
      "minItems": 1,
      "title": "Dependencies",
      "type": "array"
    },
    "gates": {
      "items": {
        "$ref": "#/$defs/PromotionGateRecord"
      },
      "minItems": 1,
      "title": "Gates",
      "type": "array"
    },
    "legacy_assessment_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Legacy Assessment Hash",
      "type": "string"
    },
    "legacy_decision": {
      "minLength": 1,
      "title": "Legacy Decision",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "schema_name": {
      "default": "d3-promotion-payload",
      "minLength": 1,
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "default": 2,
      "minimum": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "steady_state_configuration_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Steady State Configuration Hash",
      "type": "string"
    },
    "surface": {
      "minLength": 1,
      "title": "Surface",
      "type": "string"
    }
  },
  "required": [
    "component_id",
    "component_revision",
    "surface",
    "code_revision",
    "legacy_assessment_hash",
    "legacy_decision",
    "gates",
    "dependencies",
    "artifact",
    "canary_configuration_hash",
    "steady_state_configuration_hash",
    "canary_to_steady_condition_hash",
    "recorded_at"
  ],
  "title": "D3PromotionPayload",
  "type": "object"
}
