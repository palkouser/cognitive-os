{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "storage_key": {
          "minLength": 1,
          "title": "Storage Key",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "content_hash",
        "size_bytes",
        "storage_key",
        "created_at"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "NumericFeature": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "default": "",
          "title": "Content Hash",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "NumericFeature",
      "type": "object"
    }
  },
  "$id": "https://cognitive-os.local/schemas/v1/learned/situation-vector.schema.json",
  "additionalProperties": false,
  "description": "One decision situation, encoded identically for every domain.\n\nCredentials, secrets, prompt bodies, and unrestricted text are prohibited as\nfeatures; `prohibited_feature_check` records that the check ran.",
  "properties": {
    "categorical_features": {
      "default": [],
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "minLength": 1,
            "type": "string"
          },
          {
            "minLength": 1,
            "type": "string"
          }
        ],
        "type": "array"
      },
      "title": "Categorical Features",
      "type": "array"
    },
    "content_hash": {
      "default": "",
      "title": "Content Hash",
      "type": "string"
    },
    "embedding_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "encoding_version": {
      "default": "situation-v1",
      "minLength": 1,
      "title": "Encoding Version",
      "type": "string"
    },
    "numeric_features": {
      "default": [],
      "items": {
        "$ref": "#/$defs/NumericFeature"
      },
      "title": "Numeric Features",
      "type": "array"
    },
    "problem_domain": {
      "minLength": 1,
      "title": "Problem Domain",
      "type": "string"
    },
    "prohibited_feature_check": {
      "title": "Prohibited Feature Check",
      "type": "boolean"
    },
    "surface": {
      "minLength": 1,
      "title": "Surface",
      "type": "string"
    },
    "task_signature_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Task Signature Hash",
      "type": "string"
    }
  },
  "required": [
    "surface",
    "task_signature_hash",
    "problem_domain",
    "prohibited_feature_check"
  ],
  "title": "SituationVector",
  "type": "object"
}
